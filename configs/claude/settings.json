{
  "env": {
    "ANTHROPIC_MODEL": "opusplan",
    "CLAUDE_CODE_DISABLE_MOUSE_CLICKS": "1"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.env)",
      "Read(~/.netrc)",
      "Edit(~/.netrc)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "pluginConfigs": {
    "ponytail@synced": {
      "options": {
        "ledger": true,
        "sendNames": true
      }
    }
  },
  "plansDirectory": ".claude/plans",
  "tui": "fullscreen",
  "timeFormat": "24-hour",
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "autoContinueAtUsageLimit": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
